+def resolve_thermal_analysis_summary(input_dict: dict, bridge=None) -> dict | None:
+    """Return solved OpenSeesPy thermal case displacements, forces & equilibrium table."""
+    if bridge is None:
+        return None
+    out_d = getattr(bridge, "output_dict", None) or {}
